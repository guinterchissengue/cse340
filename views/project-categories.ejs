<%- include('partials/header') %>

<main id="main-content">
    <p class="breadcrumb"><a href="/project/<%= project.project_id %>">&larr; Back to <%= project.title %></a></p>

    <h1>Update Categories</h1>
    <p>Choose every category that applies to <strong><%= project.title %></strong>.</p>

    <form action="/project/<%= project.project_id %>/categories" method="POST" class="card">
        <% if (categoryOptions && categoryOptions.length > 0) { %>
            <div class="checkbox-list">
                <% categoryOptions.forEach(category => { %>
                    <div class="checkbox-item">
                        <input
                            type="checkbox"
                            id="category-<%= category.category_id %>"
                            name="category_ids"
                            value="<%= category.category_id %>"
                            <%= category.checked ? 'checked' : '' %>
                        >
                        <label for="category-<%= category.category_id %>"><%= category.name %></label>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="no-data-alert">
                <p>No categories exist yet. <a href="/new-category">Create one first</a>.</p>
            </div>
        <% } %>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Categories</button>
            <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>
