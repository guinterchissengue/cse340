<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>Welcome back, <%= user.name %>! You're logged in as <strong><%= user.role %></strong>.</p>

    <div class="grid-container">
        <div class="card">
            <h3>Organizations</h3>
            <p>Browse the partner organizations leading volunteer efforts.</p>
            <a class="card-link" href="/organizations">View organizations &rarr;</a>
        </div>
        <div class="card">
            <h3>Service Projects</h3>
            <p>Browse community service projects looking for volunteers.</p>
            <a class="card-link" href="/projects">View projects &rarr;</a>
        </div>
        <div class="card">
            <h3>Categories</h3>
            <p>Browse service projects by cause and theme.</p>
            <a class="card-link" href="/categories">View categories &rarr;</a>
        </div>
        <% if (user.role === 'admin') { %>
            <div class="card">
                <h3>Users</h3>
                <p>View every registered user and their assigned role.</p>
                <a class="card-link" href="/users">View users &rarr;</a>
            </div>
        <% } %>
    </div>

    <h2>My Volunteer Projects</h2>

    <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
        <div class="grid-container">
            <% volunteeredProjects.forEach(project => { %>
                <div class="card" data-id="<%= project.project_id %>">
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p><%= project.description %></p>
                    <p class="project-org">Led by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                    <p class="project-meta">
                        <span class="project-location">📍 <%= project.location %></span>
                        <span class="project-date">🗓️ <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </p>
                    <p class="volunteer-status">✅ You are volunteering for this project.</p>
                    <div class="card-actions">
                        <a href="/project/<%= project.project_id %>" class="card-link">View Details &rarr;</a>
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                            <input type="hidden" name="redirect_to" value="/dashboard">
                            <button type="submit" class="btn btn-secondary">Remove Volunteer</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="no-data-alert">
            <p>You haven't signed up to volunteer for any projects yet.</p>
            <a href="/projects" class="btn btn-primary">Browse Projects</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
