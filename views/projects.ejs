<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>Roll up your sleeves and get involved. Here are some of the current service projects looking for volunteers like you.</p>

    <div class="grid-container">
        <!-- Check if we actually have projects coming from the database -->
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <div class="card" data-id="<%= project.project_id %>">
                    <h3><%= project.title %></h3>
                    <p><%= project.description %></p>
                    <p class="project-org">Led by <%= project.organization_name %></p>
                    <p class="project-meta">
                        <span class="project-location">📍 <%= project.location %></span>
                        <span class="project-date">🗓️ <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </p>
                    <% if (project.categories && project.categories.length > 0) { %>
                        <div class="tag-list">
                            <% project.categories.forEach(category => { %>
                                <span class="tag"><%= category %></span>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Clean fallback state if the database table is empty -->
            <div class="no-data-alert">
                <p>No projects found. Make sure your database is seeded properly!</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
