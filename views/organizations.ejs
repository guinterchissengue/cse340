<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These partner organizations lead volunteer efforts across our community. Explore their work and find one whose mission speaks to you.</p>

    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
        <p><a href="/new-organization" class="btn btn-primary">+ New Organization</a></p>
    <% } %>

    <div class="grid-container">
        <!-- Check if we actually have organizations coming from the database -->
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <div class="card org-card" data-id="<%= org.organization_id %>">
                    <% if (org.image_path) { %>
                        <img class="org-image" src="<%= org.image_path %>" alt="<%= org.name %> logo">
                    <% } %>
                    <h3><a href="/organization/<%= org.organization_id %>"><%= org.name %></a></h3>
                    <p><%= org.description %></p>
                    <p class="org-contact">
                        Contact: <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
                    </p>
                    <a href="/organization/<%= org.organization_id %>" class="card-link">View Projects &rarr;</a>
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
                        <a href="/edit-organization/<%= org.organization_id %>" class="card-link">Edit &rarr;</a>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Clean fallback state if the database table is empty -->
            <div class="no-data-alert">
                <p>No organizations found. Make sure your database is seeded properly!</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
