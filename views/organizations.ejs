<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These partner organizations lead volunteer efforts across our community. Explore their work and find one whose mission speaks to you.</p>

    <div class="grid-container">
        <div class="card org-card">
            <img class="org-image" src="/images/org-green-earth.svg" alt="Green Earth Alliance logo showing a leaf">
            <h3>Green Earth Alliance</h3>
            <p>Leads clean-up drives, tree planting, and sustainability education to protect local habitats.</p>
        </div>
        <div class="card org-card">
            <img class="org-image" src="/images/org-bright-futures.svg" alt="Bright Futures Education logo showing an open book">
            <h3>Bright Futures Education</h3>
            <p>Provides tutoring, mentoring, and school supply drives for students of every age.</p>
        </div>
        <div class="card org-card">
            <img class="org-image" src="/images/org-neighborhood-care.svg" alt="Neighborhood Care Network logo showing people together">
            <h3>Neighborhood Care Network</h3>
            <p>Organizes food drives, home repairs, and local outreach to build stronger neighborhoods.</p>
        </div>
        <div class="card org-card">
            <img class="org-image" src="/images/org-wellness-together.svg" alt="Wellness Together logo showing a heart">
            <h3>Wellness Together</h3>
            <p>Supports clinics and wellness events that promote physical and mental health for all.</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
