<%- include('partials/header') %>

<main id="main-content">
    <section class="hero">
        <div class="hero-text">
            <p class="eyebrow">Volunteer • Connect • Serve</p>
            <h1>Turn good intentions into real community impact</h1>
            <p class="lead">Community Service Hub brings volunteers together with local organizations and service projects, so it is easy to find a cause that matters to you and start making a difference today.</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="/projects">Browse service projects</a>
                <a class="btn btn-secondary" href="/organizations">Meet our organizations</a>
            </div>
        </div>
        <img class="hero-image" src="/images/hero.svg" alt="Illustration of volunteers joining hands around a growing community">
    </section>

    <section class="section">
        <h2>Where would you like to start?</h2>
        <div class="grid-container">
            <div class="card">
                <h3>Partner Organizations</h3>
                <p>Discover the trusted local groups leading volunteer efforts across our community.</p>
                <a class="card-link" href="/organizations">View organizations &rarr;</a>
            </div>
            <div class="card">
                <h3>Service Projects</h3>
                <p>Find hands-on projects that fit your schedule, your skills, and the causes you care about.</p>
                <a class="card-link" href="/projects">View projects &rarr;</a>
            </div>
            <div class="card">
                <h3>Project Categories</h3>
                <p>Explore causes by theme, from the environment to education, community, and wellness.</p>
                <a class="card-link" href="/categories">View categories &rarr;</a>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
