<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>Explore our community service project categories below to find where you can make an impact.</p>

    <div class="grid-container">
        <!-- Check if we actually have categories coming from the database -->
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <div class="card" data-id="<%= category.category_id %>">
                    <!-- Dynamic title from the database, linking to its details page -->
                    <h3><a href="/category/<%= category.category_id %>"><%= category.name %></a></h3>

                    <p>Discover projects related to <%= category.name.toLowerCase() %> initiatives.</p>

                    <a href="/category/<%= category.category_id %>" class="card-link">View Projects &rarr;</a>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Clean fallback state if the database table is empty -->
            <div class="no-data-alert">
                <p>No categories found. Make sure your database is seeded properly!</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
