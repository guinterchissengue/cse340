<%- include('partials/header') %>

<main id="main-content">
    <p class="breadcrumb"><a href="/organizations">&larr; Back to Organizations</a></p>

    <div class="card org-card" data-id="<%= organization.organization_id %>">
        <% if (organization.image_path) { %>
            <img class="org-image" src="<%= organization.image_path %>" alt="<%= organization.name %> logo">
        <% } %>
        <h1><%= organization.name %></h1>
        <p><%= organization.description %></p>
        <p class="org-contact">
            Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
            <% if (organization.website) { %>
                &nbsp;|&nbsp; <a href="<%= organization.website %>" target="_blank" rel="noopener noreferrer">Visit Website</a>
            <% } %>
        </p>
    </div>

    <h2>Service Projects</h2>
    <div class="grid-container">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <div class="card" data-id="<%= project.project_id %>">
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p><%= project.description %></p>
                    <p class="project-meta">
                        <span class="project-location">📍 <%= project.location %></span>
                        <span class="project-date">🗓️ <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </p>
                    <% if (project.categories && project.categories.length > 0) { %>
                        <div class="tag-list">
                            <% project.categories.forEach(category => { %>
                                <a href="/category/<%= category.category_id %>" class="tag"><%= category.name %></a>
                            <% }) %>
                        </div>
                    <% } %>
                    <a href="/project/<%= project.project_id %>" class="card-link">View Details &rarr;</a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="no-data-alert">
                <p>This organization doesn't have any service projects listed yet.</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
