<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="Guinter Chissengue">
    <meta name="description" content="Community Service Hub connects volunteers with local organizations, service projects, and causes across our community.">
    <title><%= title %> | Community Service Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
        <div class="nav-container">
            <a href="/" class="site-title">Community Service Hub</a>
            <nav aria-label="Primary">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/organizations">Organizations</a></li>
                    <li><a href="/projects">Service Projects</a></li>
                    <li><a href="/categories">Categories</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <% if (typeof successMessage !== 'undefined' && successMessage.length > 0) { %>
        <div class="flash-container">
            <% successMessage.forEach(message => { %>
                <div class="flash-message flash-success" role="status"><%= message %></div>
            <% }) %>
        </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage.length > 0) { %>
        <div class="flash-container">
            <% errorMessage.forEach(message => { %>
                <div class="flash-message flash-error" role="alert"><%= message %></div>
            <% }) %>
        </div>
    <% } %>
